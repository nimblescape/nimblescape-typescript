// Build the bundles and start a second VS Code window that loads the extension
// from this folder and opens the folder examples, so that a change can be
// tried without a package. The TypeScript server of that window loads the
// plugin from node_modules/nimblescape-typescript-plugin of this folder, which
// npm links to plugin/. Install the packages of the examples first
// (npm ci --ignore-scripts --prefix examples). Run the configuration again
// after a change: the task "build" bundles the change.
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run the extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/examples"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "build"
    }
  ]
}
