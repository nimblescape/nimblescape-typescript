// The type check (npm run typecheck) with TypeScript 6.0, the same in every nimblescape extension: strict, and no
// output, because esbuild builds the bundles. ESLint (npm run lint) reads the types of the same files.
// nimblescape TypeScript: the imports name the .ts files. src/plugin.ts ends with `export =`, the form of a module
// that the TypeScript server loads with require(), so the check allows syntax that is not erasable (no
// erasableSyntaxOnly).
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "test"],
  "exclude": ["examples", "node_modules", "dist", "out"]
}
