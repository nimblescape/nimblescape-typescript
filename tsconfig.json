// The type check (npm run typecheck): strict, and no output, because esbuild builds the bundles. src/plugin.ts ends
// with `export =`, the form of a module that the TypeScript server loads with require(), so the check allows syntax
// that is not erasable (no erasableSyntaxOnly).
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vscode"
    ]
  },
  "include": [
    "src",
    "test"
  ],
  "exclude": [
    "examples",
    "node_modules",
    "dist",
    "out"
  ]
}
