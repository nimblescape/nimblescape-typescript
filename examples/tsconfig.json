{
  // The rules of the TypeScript courses: Node.js, its types, and no DOM; prompt() is a global of ts. The entry of
  // the plugin marks a project of ts, as ts --init writes it.
  "compilerOptions": {
    "strict": true,
    "module": "nodenext",
    "lib": ["es2024"],
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "plugins": [{ "name": "nimblescape-typescript-plugin" }]
  }
}
